-----------------------------------------------------
-- AHM - horizons
-----------------------------------------------------
-- Use ert/updated surfaces if they exist
-- Ert surfaces are generated for the second iteration/posterior (i.e. after prior is finished)
-- Make sure to delete the storage if you for some reason have to rerun (otherwise the prior will also get an ert updated surface)

SURFACE TOP_VOLANTIS    OUTPUT_FILE:ert_TopVolantis.gri  INIT_FILES:rms/output/hum/TopVolantis.gri  BASE_SURFACE:../../rms/output/hum/TopVolantis.gri   FORWARD_INIT:True
SURFACE TOP_THERYS      OUTPUT_FILE:ert_TopTherys.gri    INIT_FILES:rms/output/hum/TopTherys.gri    BASE_SURFACE:../../rms/output/hum/TopTherys.gri     FORWARD_INIT:True
SURFACE TOP_VOLON       OUTPUT_FILE:ert_TopVolon.gri     INIT_FILES:rms/output/hum/TopVolon.gri     BASE_SURFACE:../../rms/output/hum/TopVolon.gri	    FORWARD_INIT:True
SURFACE BASE_VOLANTIS	OUTPUT_FILE:ert_BaseVolantis.gri INIT_FILES:rms/output/hum/BaseVolantis.gri	BASE_SURFACE:../../rms/output/hum/BaseVolantis.gri  FORWARD_INIT:True
